# Variables de entorno públicas (accesibles en el cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=tu-app-id

# Variables de entorno privadas (SOLO servidor)
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=tu-cuenta-de-servicio@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# Vercel Blob (solo servidor)
BLOB_READ_WRITE_TOKEN=tu-token-de-blob-aqui

# URL base (para enlaces públicos)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
