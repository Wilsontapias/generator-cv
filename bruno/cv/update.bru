meta {
  name: Actualizar CV
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/cv/{{cvId}}
  body: json
  auth: none
}

headers {
  Cookie: sesion={{sessionId}}
}

body:json {
  {
    "titulo": "Mi CV Actualizado",
    "plantilla": "clasica"
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.status).to.equal(200);
  });
}